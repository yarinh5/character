SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_AUTH_REDIRECT_ALLOWED_ORIGINS=
VITE_PASSWORD_RESET_REDIRECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL bindings used by server-side Auth flows. Keep the allowlist to
# approved origins; clients cannot supply arbitrary redirect targets.
AUTH_REDIRECT_ALLOWED_ORIGINS=
AUTH_EMAIL_VERIFICATION_REDIRECT_URL=
ACCOUNT_DELETION_CONFIRM_REDIRECT_URL=
ACCOUNT_DELETION_CANCEL_REDIRECT_URL=

# Restore recovery authority. The HMAC key is server-only. Import, replay and
# release remain disabled until a separately authorized recovery operation.
RESTORE_RECOVERY_AUTHORITY_HMAC_KEY=
RESTORE_RECOVERY_EXPECTED_LOCK_ID=
RESTORE_RECOVERY_EXPECTED_AUTHORITY_ID=
RESTORE_RECOVERY_CONTRACT_VERSION=
RESTORE_RECOVERY_IMPORT_ENABLED=false
RESTORE_RECOVERY_REPLAY_ENABLED=false
RESTORE_RECOVERY_RELEASE_ENABLED=false

# Bot/provider and trusted-proxy contracts are intentionally absent until a
# provider and proxy boundary are approved. Do not add an always-success token.
